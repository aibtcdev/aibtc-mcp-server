# Stacks wallet mnemonic (24 words)
CLIENT_MNEMONIC="your twenty four word mnemonic phrase goes here"

# Network: mainnet or testnet
NETWORK=testnet

# x402 API base URL
API_URL=https://x402.biwas.xyz

# Pillar API
PILLAR_API_URL=https://api.pillar.fi
PILLAR_API_KEY=

# Hiro API Key (optional)
# Improves rate limits for Stacks blockchain queries
# Get your key at: https://platform.hiro.so/
HIRO_API_KEY=

# Sponsor Relay API Key (optional)
# Enables gasless transactions for ERC-8004 and sBTC
# Get your key at: https://x402-relay.aibtc.com
SPONSOR_API_KEY=

# Flying Whale Infrastructure License Key (required for Flying Whale tools)
# Without this key, all 13 Flying Whale tools are disabled.
# Obtain a license: github.com/azagh72-creator
# Tiers: Indie 100k sats/mo | Commercial 300k sats/mo | Platform: negotiate
FW_LICENSE_KEY=

# ══════════════════════════════════════════════════════════════════
# Bitcoin Core — Sovereign Bitcoin Node (OPTIONAL)
# ══════════════════════════════════════════════════════════════════
# "Don't trust, verify." — Satoshi Nakamoto
#
# When BTC_CORE_PASSWORD is set, the system uses YOUR Bitcoin Core node
# instead of mempool.space API. Full sovereignty, zero external dependency.
#
# Setup:
#   1. Download Bitcoin Core: https://bitcoincore.org
#   2. Add to bitcoin.conf:
#        server=1
#        prune=5500          # only ~10GB disk (or remove for full 600GB)
#        rpcuser=bitcoin
#        rpcpassword=YOUR_STRONG_PASSWORD
#        rpcallowip=127.0.0.1
#        rpcbind=127.0.0.1
#   3. Start Bitcoin Core and wait for sync (3-7 days first time)
#   4. Set BTC_CORE_PASSWORD below and restart MCP server
#
# Cost: $0 (open source) + electricity (~$3/month on Raspberry Pi)
# Sovereignty: 100% — you ARE the network
# ══════════════════════════════════════════════════════════════════
BTC_CORE_HOST=127.0.0.1
BTC_CORE_PORT=8332
BTC_CORE_USER=bitcoin
BTC_CORE_PASSWORD=
BTC_CORE_WALLET=
