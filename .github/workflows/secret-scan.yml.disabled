# Secret-scanning CI backstop — DISABLED FOR NOW.
#
# Kept for future use. The local pre-commit hook (.githooks/pre-commit) is the
# active gate; this would add a server-side net that --no-verify can't bypass.
#
# To re-enable: rename this file to `secret-scan.yml`. It runs the open-source
# gitleaks BINARY directly, so it needs NO license or GITLEAKS_LICENSE secret
# (only the gitleaks-ACTION wrapper requires a paid license on org repos).
# If you'd rather use the action wrapper, add a GITLEAKS_LICENSE repo secret.
#
# Triggers below are set to manual-only so this never runs until intentionally
# re-enabled; the push/pull_request triggers are commented out.
name: secret-scan

on:
  workflow_dispatch: {}
  # push:
  #   branches: ["**"]
  # pull_request:

# Least privilege: this job only needs to read the checked-out tree.
permissions:
  contents: read

jobs:
  gitleaks:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Install gitleaks
        run: |
          VERSION=8.21.2
          # SHA-256 from the v8.21.2 checksums.txt release asset. A security
          # job that reads the repo is a supply-chain target — verify the binary.
          SHA256=5bc41815076e6ed6ef8fbecc9d9b75bcae31f39029ceb55da08086315316e3ba
          curl -sSL "https://github.com/gitleaks/gitleaks/releases/download/v${VERSION}/gitleaks_${VERSION}_linux_x64.tar.gz" \
            -o gitleaks.tar.gz
          echo "${SHA256}  gitleaks.tar.gz" | sha256sum -c -
          tar -xz -f gitleaks.tar.gz gitleaks
          sudo mv gitleaks /usr/local/bin/
          gitleaks version
      # --no-git scans the working tree (current committed state), not history —
      # intentional for CI: history scanning is slow/noisy on every push.
      - name: Scan working tree for secrets
        run: gitleaks detect --no-git --source . --config .gitleaks.toml --redact --no-banner --verbose
